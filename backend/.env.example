# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Load before running locally, e.g.:
#   set -a && source .env && set +a && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
#
# Docker (production profile is the image default):
#   docker compose --env-file .env up -d --build
#   # or: docker run --env-file .env -p 8080:8080 gup-backend:latest
#

SPRING_PROFILES_ACTIVE=prod

JWT_SECRET=replace-with-at-least-32-char-secret-for-hs256
JWT_EXPIRATION_MS=604800000

DB_URL=jdbc:your_db_url
DB_USER=your_db_user
DB_PASS=your_db_password

TEST_DB_URL=jdbc:your_test_db_url
TEST_DB_USER=your_test_db_user
TEST_DB_PASS=your_test_db_password

# Required for Expo web / browser against this API (native apps skip CORS).
# Comma-separated Ant-style patterns. Defaults in prod image include localhost if unset
# (after rebuilding with latest application-prod.properties).
# CORS for Browser tests + PROD
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*

# S3-compatible object storage (MinIO / Cloudflare R2 / AWS S3).
# File bytes never pass through Spring Boot — only presigned URLs are minted here.
# Service account needs: PutObject, GetObject, DeleteObject, ListBucket on the bucket.
# Prefer an origin that does not inject unsigned headers (direct MinIO if Cloudflare breaks SigV4).
# Swap endpoint + credentials to change provider; no code changes required.
S3_ENDPOINT=your_s3_endpoint
S3_REGION=us-east-1
S3_ACCESS_KEY=your_scoped_service_account_access_key
S3_SECRET_KEY=your_scoped_service_account_secret_key
S3_BUCKET=gup-media
